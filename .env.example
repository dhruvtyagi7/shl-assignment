# Environment variables for SHL Assessment Recommender
# Copy this file to .env and fill in your values.

# REQUIRED: Google AI Studio API key (free tier)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: path to the catalog JSON file (default: catalog.json in cwd)
# CATALOG_PATH=catalog.json

# Optional: number of catalog items to retrieve per query (default: 15)
# TOP_N_RETRIEVE=15

# Optional: server port (default: 8000)
# PORT=8000
